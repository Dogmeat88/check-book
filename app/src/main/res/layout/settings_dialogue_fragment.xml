<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <TextView
                style="@style/text_heading"
                android:text="@string/settings_title"
                android:gravity="center_horizontal"
                />

            <View style="@style/horizontal_line" />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_event_duration_txt"
                android:layout_marginTop="10dp"
                />

            <RadioGroup
                android:id="@+id/settings_event_duration_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/settings_event_duration_15min"
                    style="@style/button"
                    android:text="@string/settings_event_duration_15min"
                    />
                <RadioButton
                    android:id="@+id/settings_event_duration_30min"
                    style="@style/button"
                    android:text="@string/settings_event_duration_30min"
                    />
            </RadioGroup>

            <View style="@style/horizontal_line" />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_event_book_title_txt"
                android:layout_marginTop="10dp"
                />
            <EditText
                android:id="@+id/edit_event_title"
                style="@style/edit_standard"
                />

            <View style="@style/horizontal_line" />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_beacon_toggle"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                />

            <ToggleButton
                android:id="@+id/settings_beacon_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                />
            <TextView
                android:id="@+id/settings_beacon_disabled"
                style="@style/text_content"
                android:text="@string/settings_beacon_disabled"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/warning"
                android:visibility="gone"
                />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_beacon_override_duration"
                android:layout_marginTop="10dp"
                />
            <EditText
                android:id="@+id/edit_beacon_override"
                style="@style/edit_standard"
                android:inputType="number"
                android:maxLength="3"
                />

            <View style="@style/horizontal_line" />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_refresh_resources_txt"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                />
            <Button
                android:id="@+id/settings_refresh_resources_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_refresh_resources_btn"/>

            <View style="@style/horizontal_line" />

            <Button
                style="@style/button"
                android:id="@+id/settings_done_button"
                android:text="@string/close_btn"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </ScrollView>
</layout>