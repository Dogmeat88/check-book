<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minWidth="1000dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <TextView
                style="@style/text_heading"
                android:text="@string/beacon_settings_title"
                android:gravity="center_horizontal"
                />

            <View style="@style/horizontal_line" />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_beacon_toggle"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                />

            <ToggleButton
                android:id="@+id/settings_beacon_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                />
            <TextView
                android:id="@+id/settings_beacon_disabled"
                style="@style/text_content"
                android:text="@string/settings_beacon_disabled"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/text_warning"
                android:visibility="gone"
                />

            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_beacon_scan_rate"
                android:layout_marginTop="20dp"
                />
            <SeekBar
                android:id="@+id/seek_beacon_scan_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="29"
                android:focusableInTouchMode="true"
                android:focusable="true"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.33"
                    android:text="@string/settings_beacon_scan_rate_label1"
                    />
                <TextView
                    android:id="@+id/seek_beacon_scan_rate_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.33"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.33"
                    android:text="@string/settings_beacon_scan_rate_label2"
                    android:gravity="end"
                    />
            </LinearLayout>


            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_beacon_override_duration"
                android:layout_marginTop="20dp"
                />
            <SeekBar
                android:id="@+id/seek_beacon_override_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="99"
                android:focusableInTouchMode="true"
                android:focusable="true"
                />
            <TextView
                android:id="@+id/seek_beacon_override_duration_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"/>


            <TextView
                style="@style/text_content_link"
                android:text="@string/settings_beacon_distance"
                android:layout_marginTop="20dp"
                />
            <SeekBar
                android:id="@+id/seek_beacon_trigger_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="9"
                android:focusableInTouchMode="true"
                android:focusable="true"
                />
            <TextView
                android:id="@+id/seek_beacon_trigger_distance_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"/>

            <View style="@style/horizontal_line" />

            <Button
                style="@style/button"
                android:id="@+id/settings_done_button"
                android:text="@string/close_btn"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </ScrollView>
</layout>